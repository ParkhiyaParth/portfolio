# Environment variables consumed by docker-compose.yml (production/self-hosted deploy).
# Copy to .env and fill in before running `docker compose up -d --build`.
# For local development instead, see .env.local.example and backend/.env.example.

# Public URL your visitors will use — baked into the frontend build, since
# NEXT_PUBLIC_* vars are inlined client-side and can't be changed at runtime.
# Must match the domain configured in Caddyfile.
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Optional: extra CORS origins for the backend, comma-separated.
# Not required if the frontend and backend share a domain via Caddy (see Caddyfile).
ALLOWED_ORIGINS=https://yourdomain.com
