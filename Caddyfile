# Replace with your real domain (Caddy will automatically provision an
# HTTPS certificate via Let's Encrypt once DNS points at this server).
# For local/IP-only testing, use `:80` instead and Caddy will skip TLS.
yourdomain.com {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
