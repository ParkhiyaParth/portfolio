# No domain configured yet, so this serves plain HTTP on port 80.
# Once you have a domain pointed at this server's IP, replace the line
# below with your domain (e.g. `yourdomain.com {`) and Caddy will
# automatically provision an HTTPS certificate via Let's Encrypt.
:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
